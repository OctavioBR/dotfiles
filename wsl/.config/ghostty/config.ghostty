cursor-style = block
font-family = MesloLGS Nerd Font Mono

keybind = alt+minus=new_split:down
keybind = alt+equal=new_split:right

keybind = ctrl+v=paste_from_clipboard

keybind = ctrl+t=new_tab
keybind = ctrl+w=close_surface

keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5

keybind = alt+left=goto_split:left
keybind = alt+right=goto_split:right
keybind = alt+up=goto_split:up
keybind = alt+down=goto_split:down

keybind = shift+alt+down=resize_split:down,10
keybind = shift+alt+up=resize_split:up,10
keybind = shift+alt+right=resize_split:right,10
keybind = shift+alt+left=resize_split:left,10

# keybind = shift+page_up=scroll_page_up
# keybind = shift+page_down=scroll_page_down
# keybind = shift+home=scroll_to_top
# keybind = shift+end=scroll_to_bottom

scrollback-limit = 10000000

# Closest equivalent of kitty's "dump scrollback into an editor" binding;
# opens the scrollback in the OS default handler rather than `code` specifically.
keybind = ctrl+shift+e=write_scrollback_file:open
